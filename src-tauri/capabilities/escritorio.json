{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "escritorio",
  "description": "Solo en el programa de Windows: actualización automática, reinicio y abrir WhatsApp o Enlace Móvil",
  "windows": [
    "main"
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "permissions": [
    "updater:default",
    "process:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "whatsapp:*"
        },
        {
          "url": "whatsapp://*"
        },
        {
          "url": "sms:*"
        }
      ]
    }
  ]
}
