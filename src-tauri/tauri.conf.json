{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cobro",
  "version": "0.1.0",
  "identifier": "pr.supermobile.cobro",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cobro · Super Mobile",
        "width": 1320,
        "height": 860,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Super Mobile Tech Repair",
    "shortDescription": "Facturación de ventas, servicios y reparaciones",
    "longDescription": "Cobro: facturación minimalista de Super Mobile Tech Repair que funciona sin internet.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
